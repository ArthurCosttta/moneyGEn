{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowLocal Node Flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "nodes"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "inputs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
          "type": { "type": "string", "enum": ["image", "text"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "required": { "type": "boolean" },
          "default": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "video_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": { "type": "string" },
        "aspect": { "type": "string", "enum": ["9:16", "16:9", "1:1"] },
        "duration_seconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 60 },
        "resolution": { "type": ["string", "null"] }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
          "type": { "type": "string", "enum": ["gpt_json", "image_gen", "scene_fanout", "video_batch"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "depends_on": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
